{
  "expo": {
    "scheme": "techzu",
    "userInterfaceStyle": "light",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "techzu",
    "slug": "techzu",
    "plugins": ["expo-font"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.yeasin.outside.expostarter",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true
    }
  }
